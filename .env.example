# Schwab Trader API (developer.schwab.com -> Individual Developer App)
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://localhost:8443/callback
SCHWAB_ACCOUNT_HASH=

# Anthropic (Claude) for LLM-driven premarket setup classification
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-sonnet-4-6

# AI Agent Brain: Claude validates EVERY trade with full market context
AGENT_BRAIN_ENABLED=true
AGENT_BRAIN_MIN_CONVICTION=70

# Mode
LIVE_TRADING=false
KILL_SWITCH=false

# Risk
MAX_RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_EQUITY_POSITIONS=3
MAX_CONCURRENT_OPTION_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DAY_TRADES=4

# Engine A (Opening Range Breakout, equities)
ORB_ENABLED=true
ORB_MIN_GAP_PCT=2.0
ORB_MIN_PREMARKET_VOLUME=500000
ORB_MIN_PRICE=5.0
ORB_MAX_PRICE=50.0

# Engine B (0DTE SPY options scalping)
DTE0_ENABLED=true
DTE0_MAX_CONTRACTS_PER_TRADE=1
DTE0_MAX_TRADES_PER_DAY=2

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Logging
LOG_LEVEL=info
